# ============================================================================
# RATE MY PATAKHA — ENVIRONMENT VARIABLES (.env.local)
# Copy this file to `.env.local` and fill in your MongoDB connection URI
# ============================================================================

# 1. MongoDB Connection String (MongoDB Atlas or local instance)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ratemypatakha?retryWrites=true&w=majority
MONGODB_URI=

# 2. Optional: Database Name (defaults to "ratemypatakha")
MONGODB_DB=ratemypatakha

# 3. Optional: Public Base URL used for generating shareable links (auto-detected in browser if blank)
NEXT_PUBLIC_APP_URL=http://localhost:3005